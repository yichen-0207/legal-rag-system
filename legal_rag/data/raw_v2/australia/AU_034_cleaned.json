  {
    "doc_id": "AU_ACT_44_2025_ART_005",
    "jurisdiction": "澳大利亚",
    "law_id": "AU_ACT_44_2025",
    "law_name": "Pacific Banking Guarantee Act 2025",
    "law_name_original": "Pacific Banking Guarantee Act 2025",
    "law_type": "Act",
    "article_number": "5",
    "article_number_normalized": "005",
    "article_title": "Appropriation",
    "chunk_index": 4,
    "chapter": "",
    "chapter_title": "",
    "text_zh": "",
    "text_pt": "",
    "text_en": "The Consolidated Revenue Fund is appropriated for the purposes of meeting any liabilities that the Commonwealth incurs under Pacific banking guarantees.\nA guarantee with an ADI is a Pacific banking guarantee if:\n(a) the guarantee is granted to the ADI on behalf of the Commonwealth under section 60 of the Public Governance, Performance and Accountability Act 2013 ; and\n(b) the guarantee relates to the ADI’s banking business (within the meaning of the Banking Act 1959 ) in the Pacific region; and\n(c) the ADI’s headquarters are located in Australia.\n[ Minister’s second reading speech made in—\nHouse of Representatives on 24 July 2025\nSenate on 31 July 2025 ]\n(38/25)",
    "text_original_language": "en",
    "word_count_zh": 0,
    "chunk_type": "substantive",
    "is_substantive": true,
    "sub_chunks": [
      {
        "marker": "A",
        "content": "the guarantee is granted to the ADI on behalf of the Commonwealth under section 60 of the Public Governance, Performance and Accountability Act 2013 ; and"
      },
      {
        "marker": "B",
        "content": "the guarantee relates to the ADI’s banking business (within the meaning of the Banking Act 1959 ) in the Pacific region; and"
      },
      {
        "marker": "C",
        "content": "the ADI’s headquarters are located in Australia.\n[ Minister’s second reading speech made in—\nHouse of Representatives on 24 July 2025\nSenate on 31 July 2025 ]\n(38/25)"
      }
    ],
