  {
    "doc_id": "CN_DOC_CN_152_ART_006",
    "jurisdiction": "中国大陆",
    "law_id": "CN_DOC_CN_152",
    "law_name": "高等学校计算机网络电子公告服务管理规定",
    "law_name_original": "高等学校计算机网络电子公告服务管理规定",
