    "sub_chunks": [
      {
        "marker": "",
        "content": "The Minister of Economy, Trade and Industry may, when their find it necessary in order to achieve the sound development of foreign trade and the national economy, attach conditions to an import quota allocated under Article 9, paragraph (1) with respect to the period of import, place of origin or place of shipment of goods and other matters concerning import."
      }
