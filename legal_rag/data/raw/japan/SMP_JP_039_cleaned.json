  {
    "doc_id": "JP_Act_0000_SMP_JP_039_ART_011",
    "jurisdiction": "日本",
    "law_id": "JP_Act_0000_SMP_JP_039",
    "law_name": "Import Trade Control Order",
    "law_name_original": "Import Trade Control Order",
    "law_type": "Act",
    "article_number": "11",
    "article_number_normalized": "011",
    "article_title": ". (Conditions to Import Quota)",
    "chunk_index": 10,
    "chapter": "",
    "chapter_title": "",
    "text_zh": "",
    "text_pt": "",
    "text_en": "The Minister of Economy, Trade and Industry may, when their find it necessary in order to achieve the sound development of foreign trade and the national economy, attach conditions to an import quota allocated under Article 9, paragraph (1) with respect to the period of import, place of origin or place of shipment of goods and other matters concerning import.",
