  {
    "doc_id": "JP_Act_0000_SMP_JP_039_ART_009",
    "jurisdiction": "日本",
    "law_id": "JP_Act_0000_SMP_JP_039",
    "law_name": "Import Trade Control Order",
    "law_name_original": "Import Trade Control Order",
    "law_type": "Act",
    "article_number": "9",
    "article_number_normalized": "009",
    "article_title": ". (Import Quota)",
    "chunk_index": 8,
    "chapter": "",
    "chapter_title": "",
    "text_zh": "",
    "text_pt": "",
    "text_en": "A person who intends to import goods falling into the items publicized under Article 3, paragraph (1) as items subject to import quotas may not obtain import approval prescribed in Article 4, paragraph (1) unless and until the person applies to the Minister of Economy, Trade and Industry for an import quota pertaining to the import of the relevant goods; provided, however, that this does not apply where a person entrusted with import by another person who has obtained an import quota intends to import the relevant goods in the cases specified by the Minister of Economy, Trade and Industry, or that person has obtained confirmation from the Minister of Economy, Trade and Industry.",
    "text_original_language": "en",
    "word_count_zh": 0,
    "chunk_type": "substantive",
    "is_substantive": true,
    "sub_chunks": [
      {
        "marker": "",
        "content": "A person who intends to import goods falling into the items publicized under Article 3, paragraph (1) as items subject to import quotas may not obtain import approval prescribed in Article 4, paragraph (1) unless and until the person applies to the Minister of Economy, Trade and Industry for an import quota pertaining to the import of the relevant goods; provided, however, that this does not apply where a person entrusted with import by another person who has obtained an import quota intends to import the relevant goods in the cases specified by the Minister of Economy, Trade and Industry, or that person has obtained confirmation from the Minister of Economy, Trade and Industry."
      }
    ],
