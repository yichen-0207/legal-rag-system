  {
    "doc_id": "MAC_LEI_2_2006_ART_003",
    "jurisdiction": "澳门",
    "law_id": "MAC_LEI_2_2006",
    "law_name": "預防及遏止清洗黑錢犯罪",
    "law_name_original": null,
    "law_type": "法律",
