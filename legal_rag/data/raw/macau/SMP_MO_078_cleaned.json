  {
    "doc_id": "MAC_LEI_2_2026_ART_003",
    "jurisdiction": "澳门",
    "law_id": "MAC_LEI_2_2026",
    "law_name": "附件表一欄目2所指的局長薪俸點的報酬；第三款所指的副秘",
