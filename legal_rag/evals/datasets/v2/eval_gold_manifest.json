  },
  {
   "id": "D4",
   "title": "gold 条数上限造成 recall 天花板",
   "impact": "F1 8 / F2 5 / F3 12 / legacy 10"
  },
  {
   "id": "D5",
   "title": "低资源法域样本过少",
   "impact": "新加坡 4 条、越南 4 条、马来西亚 6 条基础查询，分法域指标不可比"
  },
  {
   "id": "D6",
   "title": "legacy 查询概念粒度粗于主题",
   "impact": "条款级 gold 错配，legacy 仅用于法规级指标与新旧对照"
  },
  {
   "id": "D7",
   "title": "主题标签重复/近义",
   "impact": "政府采购双 ID 合并，金融监管与金融服务不合并"
  },
  {
   "id": "D8",
   "title": "条文重复与异常编号",
   "impact": "按文本哈希去重；article_number 存在 Sch1/44ZZ/63F 等"
  },
  {
   "id": "D9",
   "title": "中国大陆/澳门法规在 D 变体中保留中文/葡文原名",
   "impact": "语料无官方英译，D 变体实为混合语言"
  },
  {
   "id": "D10",
   "title": "中国大陆、澳大利亚、韩国无法规级外部清单 gold",
   "impact": "其 gold_law_source 为 derived，无外部法规清单背书"
  },
  {
   "id": "D11",
   "title": "主题标注器的召回不足",
   "impact": "日本等英文译本条款大量缺少 topics_details；新条款 gold 只覆盖 K 的 36/128 部法规（28.1%），50/80 条 legacy 查询零覆盖（见 selfcheck）"
  },
  {
   "id": "D12",
   "title": "过滤规则损失部分 K 法规在检索候选中出现过的条款",
   "impact": "长度>3000 等排除规则使 15.6% 的 K 法规候选条款不进入候选池；换来的是避免长附件/修订附表霸榜"
  },
  {
   "id": "D13",
   "title": "两个主题标签在标注与出题时不同名",
   "impact": "raw_v2 的 topics_details.label_zh 为「金融服务」「电信」，taxonomy 2.5 为「金融服务与监管」「电信与通讯」；gold 按 topic_id 选取不受影响，但查询词与条款词表的词汇匹配变难，属跨系统比较的混杂因素"
  },
  {
   "id": "D14",
